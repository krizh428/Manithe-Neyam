PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/home-website
JWT_SECRET=your_super_secret_jwt_key
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# If port 5000 is already used by another app, change PORT here and start the website with
# API_PROXY_TARGET=http://localhost:<PORT> npm run dev
